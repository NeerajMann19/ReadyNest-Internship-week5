# Core Settings
PROJECT_NAME="Prism IQ"
ENVIRONMENT="local"

# Database Configuration
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/prismiq"

# Redis Cache Settings
REDIS_URL="redis://localhost:6379/0"

# Security Settings
SECRET_KEY="your-secret-key-placeholder"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Reports Configuration
REPORT_RETENTION_DAYS=30
MAX_REPORT_SIZE_MB=25
DEFAULT_PDF_THEME="classic"

